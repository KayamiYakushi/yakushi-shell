post_install() {
    cat <<'MSG'
==> Yakushi Shell is in /usr/share/yakushi-shell; the command is /usr/bin/yakushi.
==> New here? Set up Hyprland for it once (yours is moved aside, never deleted):
      yakushi setup-hyprland
    then log out and back in.
==> Coming from ./install.sh (a copy in ~/.local/share)? Switch over once:
      ~/.local/share/yakushi-shell/install.sh --uninstall   (stops the shell, removes the copy)
      yakushi start
==> Your settings in ~/.config/yakushi are not touched.
==> The login screen is the SDDM theme "yakushi". To use it, once:
      printf '[Theme]\nCurrent=yakushi\n' | sudo tee /etc/sddm.conf.d/yakushi-theme.conf
    then Settings -> Login Screen -> MATCH THE SHELL.
MSG
}

post_upgrade() {
    echo "==> Run 'yakushi restart' to load the new version (the lock screen picks it up on its next start)."
    echo "==> The login screen (SDDM) changes on the next login; Settings -> Login Screen -> MATCH THE SHELL copies your accent, clock and picture into it."
}
