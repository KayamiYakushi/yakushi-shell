#!/bin/sh
# yakushi: the one command for the Yakushi shell.
#
#   yakushi start | stop | restart     The shell (top bar, volume pill, Settings).
#   yakushi status                     Is it running? (exit 0 if so)
#   yakushi login                      Everything a new session needs (run once
#                                      from Hyprland's startup list).
#   yakushi settings [page]            Toggle Settings, or open it on a page
#                                      (e.g. tasks, network, topbar).
#   yakushi volume up|down|mute        Change the volume and show the pill.
#   yakushi bar show|hide|toggle       The top bar.
#   yakushi launcher [clipboard]       The app launcher, or clipboard history.
#   yakushi power                      The top bar's power menu.
#   yakushi lock                       Lock the screen (returns when unlocked).
#   yakushi lock preview               The lock screen in a window, nothing locked:
#                                      try the look and your password safely.
#   yakushi suspend                    Lock, wait until every screen is covered,
#                                      then sleep.
#   yakushi notifications on|off|toggle|test
#                                      Show notifications or not (off: apps are
#                                      still answered at once, nothing is shown).
#   yakushi wallpaper                  The wallpaper picker.
#   yakushi share-picker               Screen-share picker (for xdg-desktop-portal-hyprland).
#   yakushi unfreeze                   End every stuck Quickshell and start again.
#   yakushi config init|path|get [s]   The settings file.
#   yakushi ipc <target> <fn> [args]   Raw IPC call (starts the shell if needed).
#
# Nothing is a fixed path: the shell is found from where this file really
# lives (through any symlink, e.g. ~/.local/bin/yakushi), and runtime files go
# to $XDG_RUNTIME_DIR.

set -u

self="$(readlink -f -- "$0")" || exit 1
root="$(cd -- "$(dirname -- "$self")/.." && pwd -P)" || exit 1
scripts="$root/scripts"
shell_qml="$root/shell.qml"
settings_qml="$root/settings.qml"
lock_qml="$root/lock.qml"

die() {
    printf 'yakushi: %s\n' "$*" >&2
    exit 1
}

# No /tmp fallback on purpose: a guessable folder there could be made by
# another user first. systemd always sets XDG_RUNTIME_DIR.
case "${XDG_RUNTIME_DIR:-}" in
    /*) ;;
    *) die "XDG_RUNTIME_DIR is not set; log in through a systemd session." ;;
esac
run="$XDG_RUNTIME_DIR/yakushi"
mkdir -p -m 700 "$run" || die "cannot create $run"
pid_file="$run/shell.pid"
log_file="$run/shell.log"

# ---------------------------------------------------------------------------
# The shell process
# ---------------------------------------------------------------------------

# the shell's pid, only if that process really is this shell (a pid number
# can be reused by another program after the shell has gone)
shell_pid() {
    [ -r "$pid_file" ] || return 1
    pid="$(cat "$pid_file" 2>/dev/null)"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    grep -qa -- "$shell_qml" "/proc/$pid/cmdline" 2>/dev/null && echo "$pid"
}

running() {
    shell_pid >/dev/null
}

# Settings runs as a child of the shell. If the shell went away (stopped or
# crashed) while Settings was open, close that leftover Settings too, so the
# next SUPER + I always gets a fresh one.
stop_settings() {
    timeout 2 qs kill -p "$settings_qml" >/dev/null 2>&1
}

start() {
    running && return 0
    stop_settings
    # Create the config (carrying over old settings) or upgrade it first, so
    # the shell finds a current file to watch.
    python3 "$scripts/yakushi-configctl.py" init >/dev/null 2>&1
    setsid qs -n -p "$shell_qml" >"$log_file" 2>&1 </dev/null &
    printf '%s\n' "$!" >"$pid_file"
}

stop() {
    if pid="$(shell_pid)"; then
        kill "$pid" 2>/dev/null
        # wait up to 2 s for it to go, so a restart never runs two at once
        i=0
        while [ "$i" -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 0.1
            i=$((i + 1))
        done
        kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$pid_file"
    stop_settings
}

call() {
    # qs answers an unknown function (or one named like its own subcommands,
    # e.g. "show") by listing the targets, with exit code 0: that is a failure
    out="$(timeout 2 qs -p "$shell_qml" ipc call "$@" 2>&1)" || return 1
    case "$out" in
        "target "*|*"No running instances"*|*"does not exist"*|*"not found"*) return 1 ;;
    esac
    return 0
}

ipc() {
    call "$@" && return 0
    # not running (or not answering): start it and give it a moment to load
    running || start
    i=0
    while [ "$i" -lt 30 ]; do
        sleep 0.1
        call "$@" && return 0
        i=$((i + 1))
    done
    return 1
}

# ---------------------------------------------------------------------------
# Lock screen: its own process, never the shell's, so a crash or restart of
# the bar cannot touch it.
# ---------------------------------------------------------------------------

# the package's own PAM service, when it is installed (else lock.qml uses "login")
pam_service() {
    [ -r /etc/pam.d/yakushi-lock ] && export YAKUSHI_PAM_SERVICE=yakushi-lock
    return 0
}

lock() {
    # one lock at a time: a second `yakushi lock` (auto lock while already
    # locked, a key pressed twice) just returns
    exec 9>"$run/lock.flock" || return 1
    flock -n 9 || return 0

    # If the lock process dies while locked, the compositor keeps the session
    # locked; start it again so you get the password field back. A clean
    # unlock exits 0. A lock that cannot even load (exit 255) never locked
    # anything, so it is not retried for ever.
    pam_service
    : >"$run/lock.log"
    tries=0
    while [ "$tries" -lt 5 ]; do
        qs -n -p "$lock_qml" >>"$run/lock.log" 2>&1 </dev/null
        [ $? -eq 0 ] && return 0
        tries=$((tries + 1))
        sleep 0.3
    done
    return 1
}

lock_preview() {
    pam_service
    YAKUSHI_LOCK_PREVIEW=1 exec qs -p "$lock_qml" >/dev/null 2>&1 </dev/null
}

locked() {
    [ "$(timeout 1 qs -p "$lock_qml" ipc call lock isLocked 2>/dev/null)" = yes ]
}

suspend_session() {
    setsid "$self" lock >/dev/null 2>&1 </dev/null &
    # wait (at most 3 s) until every screen is covered, so nothing shows for
    # a moment on wake-up
    i=0
    while [ "$i" -lt 30 ] && ! locked; do
        sleep 0.1
        i=$((i + 1))
    done
    exec systemctl suspend
}

# ---------------------------------------------------------------------------
# Session start
# ---------------------------------------------------------------------------

login() {
    # your cursor from the first second, and shake to find if it is on
    python3 "$scripts/yakushi-cursorctl.py" login >/dev/null 2>&1 &
    python3 "$scripts/yakushi-shake.py" --login >/dev/null 2>&1 &
    # hyprsunset runs only while night light is on
    python3 "$scripts/yakushi-nightlightctl.py" restore >/dev/null 2>&1 &
    start
    # one guard check a little later, gently, then it exits
    ( sleep 8 && exec nice -n 10 ionice -c 3 python3 "$scripts/yakushi-securityctl.py" login ) \
        >/dev/null 2>&1 &
}

unfreeze() {
    # For when the bar, Settings or a pop-up stops answering: ends every
    # Quickshell of yours, then starts the shell again. Your windows and
    # apps are not touched.
    uid="$(id -u)"
    for name in qs quickshell; do
        pkill -KILL -u "$uid" -x "$name" 2>/dev/null
    done
    rm -f "$pid_file"
    sleep 0.3
    start
}

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$self" >&2
    exit 2
}

# ---------------------------------------------------------------------------

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    start)    start ;;
    stop)     stop ;;
    restart)  stop; start ;;
    status)   running ;;
    login)    login ;;
    settings)
        if [ $# -gt 0 ]; then ipc settings open "$1"; else ipc settings toggle; fi ;;
    volume)
        case "${1:-}" in
            up)   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;   # never past 100 % (like the bar)
            down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
            show) ;;
            *)    usage ;;
        esac
        ipc volumeOsd reveal ;;
    bar)
        case "${1:-}" in
            show)   ipc topbar reveal ;;
            hide|toggle) ipc topbar "$1" ;;
            *) usage ;;
        esac ;;
    launcher)
        case "${1:-}" in
            "")        ipc launcher toggle ;;
            clipboard) ipc launcher clipboard ;;
            *)         usage ;;
        esac ;;
    power)    ipc topbar power ;;
    lock)
        case "${1:-}" in
            "")      lock ;;
            preview) lock_preview ;;
            *)       usage ;;
        esac ;;
    suspend)  suspend_session ;;
    notifications)
        case "${1:-}" in
            on|off) exec python3 "$scripts/yakushi-notifyctl.py" set enabled "$1" ;;
            toggle|test) exec python3 "$scripts/yakushi-notifyctl.py" "$1" ;;
            *) usage ;;
        esac ;;
    wallpaper) exec sh "$root/wallpicker/launch.sh" ;;
    share-picker) exec sh "$scripts/share-picker.sh" ;;
    unfreeze) unfreeze ;;
    config)   exec python3 "$scripts/yakushi-configctl.py" "$@" ;;
    ipc)      [ $# -ge 2 ] || usage; ipc "$@" ;;
    *)        usage ;;
esac
